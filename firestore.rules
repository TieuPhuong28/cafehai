rules_version = '2';

// Quy tắc bảo mật Firestore cho app Cafe Hải.
// Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Menu, khuyến mãi, cấu hình điểm, quà: ai cũng xem, chỉ quầy sửa
    match /config/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Danh sách nhân viên quầy: chỉ tạo/sửa trong Firebase Console
    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Đơn hàng
    match /orders/{orderId} {
      // Ai có mã đơn (chuỗi ngẫu nhiên dài) thì xem được trạng thái đơn của mình
      allow get: if true;
      // Danh sách: quầy xem tất cả; khách chỉ xem đơn gắn với tài khoản của mình
      allow list: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      // Khách tạo đơn mới (có hoặc không đăng nhập)
      allow create: if request.resource.data.status == 'moi'
        && request.resource.data.id == orderId
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.get('credited', false) == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30;
      // Chỉ quầy đổi trạng thái, cộng điểm, xóa
      allow update, delete: if isStaff();
    }

    // Tài khoản khách: điểm chỉ quầy được cộng/trừ
    match /customers/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.points == 0
        && request.resource.data.earned == 0;
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nick', 'hide']));
      allow delete: if false;
    }

    // Góc quán: bảng giá đồ (quầy tự đồng bộ từ app khi đăng nhập)
    match /cornerShop/{item} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Góc quán của từng khách.
    // xu, stats, firsts, gifts: chỉ quầy cộng (khi hoàn tất đơn).
    // Khách chỉ được: tạo góc trống, sắp xếp đồ (layout), mua đồ đúng giá trong cornerShop.
    match /corners/{uid} {
      function isOwner() { return signedIn() && request.auth.uid == uid; }
      function emptyCorner() {
        let d = request.resource.data;
        return d.keys().hasOnly(['xu', 'spent', 'owned', 'layout', 'stats', 'firsts', 'gifts'])
          && d.xu == 0 && d.spent == 0
          && d.owned is map && d.owned.size() == 0
          && d.stats is map && d.stats.size() == 0
          && d.firsts is map && d.firsts.size() == 0
          && d.gifts is map && d.gifts.size() == 0
          && d.layout is list && d.layout.size() <= 24;
      }
      function layoutOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['layout'])
          && request.resource.data.layout is list
          && request.resource.data.layout.size() <= 24;
      }
      function validPurchase() {
        let d = request.resource.data;
        let o = resource.data;
        let item = d.lastBuy;
        let shop = get(/databases/$(database)/documents/cornerShop/$(item)).data;
        return d.diff(o).affectedKeys().hasOnly(['spent', 'owned', 'lastBuy', 'layout'])
          && d.owned.diff(o.owned).affectedKeys().hasOnly([item])
          && d.owned[item] == o.owned.get(item, 0) + 1
          && d.owned[item] <= shop.max
          && shop.price > 0
          && d.spent == o.spent + shop.price
          && d.spent <= o.xu
          && (shop.needN == 0 || o.stats.get(shop.need, 0) >= shop.needN)
          && d.layout is list && d.layout.size() <= 24;
      }
      allow read: if isOwner() || isStaff();
      allow create: if isStaff() || (isOwner() && emptyCorner());
      allow update: if isStaff() || (isOwner() && (layoutOnly() || validPurchase()));
      allow delete: if false;
    }

    // Bảng xếp hạng: ai cũng xem, chỉ quầy ghi (khi hoàn tất đơn)
    match /scores/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
